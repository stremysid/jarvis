{
  "schemaVersion": "2026.8.27",
  "path": "/v1/runs",
  "outboundRequestFields": ["input", "session_id", "instructions", "model", "provider", "model_options"],
  "wireArtifacts": {
    "schema": {"file": "schemas/hermes-runs-wire-v2026.8.27.schema.json", "canonicalSha256": "7b416b295f07ffb2d69314a3420fac3c31b0e1b6e9721498c7cf3efcba1422bb"},
    "golden": {"file": "test/fixtures/runs-wire-golden-v1.json", "canonicalSha256": "e6e60e6c82fa7becf8ce7ff6a054634f86a92033218a915e466623d67d523544"}
  },
  "modelOptions": {"none": {"reasoning": {"enabled": false}}, "low": {"reasoning": {"enabled": true, "effort": "low"}}, "high": {"reasoning": {"enabled": true, "effort": "high"}}, "max": {"reasoning": {"enabled": true, "effort": "max"}}},
  "admission": {"status": 202, "contentType": "application/json; charset=utf-8", "body": {"run_id": "run_[0-9a-f]{32}", "status": "started"}},
  "events": {
    "status": 200,
    "contentType": "text/event-stream",
    "framing": {"dataOnly": true, "ordinaryJson": true, "preterminalComment": ": keepalive", "postterminalComment": ": stream closed"},
    "allowed": {
      "message.delta": ["event", "run_id", "timestamp", "delta"],
      "reasoning.available": ["event", "run_id", "timestamp", "text"],
      "run.completed": ["event", "run_id", "timestamp", "output", "usage"],
      "run.failed": ["event", "run_id", "timestamp", "error"],
      "run.cancelled": ["event", "run_id", "timestamp"]
    },
    "discardOnly": ["reasoning.available"],
    "usageFields": ["input_tokens", "output_tokens", "total_tokens"]
  },
  "stop": {"path": "/v1/runs/{run_id}/stop", "status": 200, "contentType": "application/json; charset=utf-8", "body": {"run_id": "run_[0-9a-f]{32}", "status": "stopping"}},
  "get": {
    "path": "/v1/runs/{run_id}",
    "status": 200,
    "contentType": "application/json; charset=utf-8",
    "baseFields": ["object", "run_id", "status", "updated_at", "created_at", "session_id", "model"],
    "statuses": {
      "queued": [],
      "running": [[], ["last_event", "reasoning.available"]],
      "stopping": [["last_event", "run.stopping"]],
      "completed": [["last_event", "run.completed", "output", "usage"]],
      "failed": [["last_event", "run.failed", "error"]],
      "cancelled": [["last_event", "run.cancelled"]]
    }
  },
  "notFound": {"status": 404, "contentType": "application/json; charset=utf-8", "body": {"error": {"message": "Run not found: run_<32 lowercase hex>", "type": "invalid_request_error", "param": null, "code": "run_not_found"}}}
}
