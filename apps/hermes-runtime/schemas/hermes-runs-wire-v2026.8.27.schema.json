"event":{"oneOf":[{"type":"object","additionalProperties":false,"required":["event","run_id","timestamp","delta"],"properties":{"event":{"const":"message.delta"},"run_id":{"$ref":"#/$defs/runId"},"timestamp":{"$ref":"#/$defs/time"},"delta":{"$ref":"#/$defs/text"}}},{"type":"object","additionalProperties":false,"required":["event","run_id","timestamp","text"],"properties":{"event":{"const":"reasoning.available"},"run_id":{"$ref":"#/$defs/runId"},"timestamp":{"$ref":"#/$defs/time"},"text":{"$ref":"#/$defs/text"}}},{"type":"object","additionalProperties":false,"required":["event","run_id","timestamp","output","usage"],"properties":{"event":{"const":"run.completed"},"run_id":{"$ref":"#/$defs/runId"},"timestamp":{"$ref":"#/$defs/time"},"output":{"$ref":"#/$defs/text"},"usage":{"$ref":"#/$defs/usage"}}},{"type":"object","additionalProperties":false,"required":["event","run_id","timestamp","error"],"properties":{"event":{"const":"run.failed"},"run_id":{"$ref":"#/$defs/runId"},"timestamp":{"$ref":"#/$defs/time"},"error":{"$ref":"#/$defs/text"}}},{"type":"object","additionalProperties":false,"required":["event","run_id","timestamp"],"properties":{"event":{"const":"run.cancelled"},"run_id":{"$ref":"#/$defs/runId"},"timestamp":{"$ref":"#/$defs/time"}}}]},
"getBase":{"type":"object","required":["object","run_id","status","updated_at","created_at","session_id","model"],"properties":{"object":{"const":"hermes.run"},"run_id":{"$ref":"#/$defs/runId"},"status":{"enum":["queued","running","stopping","completed","failed","cancelled"]},"updated_at":{"$ref":"#/$defs/time"},"created_at":{"$ref":"#/$defs/time"},"session_id":{"$ref":"#/$defs/sessionId"},"model":{"const":"deepseek-v4-pro"}}},
"get":{"oneOf":[
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"properties":{"status":{"const":"queued"}},"unevaluatedProperties":false},
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"properties":{"status":{"const":"running"}},"unevaluatedProperties":false},
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"required":["last_event"],"properties":{"status":{"const":"running"},"last_event":{"const":"reasoning.available"}},"unevaluatedProperties":false},
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"required":["last_event"],"properties":{"status":{"const":"stopping"},"last_event":{"const":"run.stopping"}},"unevaluatedProperties":false},
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"required":["last_event","output","usage"],"properties":{"status":{"const":"completed"},"last_event":{"const":"run.completed"},"output":{"$ref":"#/$defs/text"},"usage":{"$ref":"#/$defs/usage"}},"unevaluatedProperties":false},
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"required":["last_event","error"],"properties":{"status":{"const":"failed"},"last_event":{"const":"run.failed"},"error":{"$ref":"#/$defs/text"}},"unevaluatedProperties":false},
{"type":"object","allOf":[{"$ref":"#/$defs/getBase"}],"required":["last_event"],"properties":{"status":{"const":"cancelled"},"last_event":{"const":"run.cancelled"}},"unevaluatedProperties":false}
]}},"type":"object","additionalProperties":false,"required":["request","admission","stop","notFound","event","get"],"properties":{"request":{"$ref":"#/$defs/request"},"admission":{"$ref":"#/$defs/admission"},"stop":{"$ref":"#/$defs/stop"},"notFound":{"$ref":"#/$defs/notFound"},"event":{"$ref":"#/$defs/event"},"get":{"$ref":"#/$defs/get"}}}
