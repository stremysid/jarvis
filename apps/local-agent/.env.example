# Jarvis local agent configuration.
#
# Every name below is required; `jarvis doctor` reports which are missing
# without ever printing a value. Copy to .env and fill in. Do not commit .env.

# Origin only -- https, no trailing path. The agent builds request paths itself.
JARVIS_CLOUD_BASE_URL=https://jarvis.example

# Issued by cloud device enrollment.
JARVIS_DEVICE_ID=
JARVIS_PRINCIPAL_ID=

# Absolute paths. The device key is DPAPI-sealed at rest; the archive is
# append-only and is the permanent record, so keep it off removable media.
JARVIS_DEVICE_KEY_PATH=C:\Users\you\AppData\Local\Jarvis\device.key
JARVIS_ARCHIVE_PATH=C:\Users\you\AppData\Local\Jarvis\archive.sqlite3
JARVIS_MEMORY_PATH=C:\Users\you\AppData\Local\Jarvis\memory.sqlite3

# Linux home-node equivalents. Use these instead of the Windows paths above.
# The socket parent is created owner-only; systemd's RuntimeDirectory creates
# /run/jarvis before the process starts.
# JARVIS_DEVICE_KEY_PATH=/var/lib/jarvis/device.key
# JARVIS_ARCHIVE_PATH=/var/lib/jarvis/archive.sqlite3
# JARVIS_MEMORY_PATH=/var/lib/jarvis/memory.sqlite3
# JARVIS_CONTROL_SOCKET=/run/jarvis/control.sock
