[Unit]
Description=Jarvis home node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/local-agent
EnvironmentFile=/etc/jarvis/node.env
ExecStart=/opt/jarvis/local-agent/.venv/bin/jarvis node
RuntimeDirectory=jarvis
RuntimeDirectoryMode=0700
StateDirectory=jarvis
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10s
TimeoutStopSec=120s
# Configuration and authentication need a person; restarting repeats them.
RestartPreventExitStatus=3 5

[Install]
WantedBy=multi-user.target
