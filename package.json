{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest --config vitest.workspace.ts run",
    "test:cloud": "pnpm --filter @jarvis/cloud-gateway test",
    "test:acceptance": "vitest --config vitest.workspace.ts run tests/acceptance",
    "test:voice-smoke": "vitest --config vitest.workspace.ts run tests/acceptance/live/voice-smoke.test.ts",
    "smoke:voice": "node tests/acceptance/live/voice-smoke-cli.mjs",
    "release:voice-gate": "node tests/acceptance/live/voice-smoke-cli.mjs --audit-evidence",
    "clean:voice-smoke-evidence": "node tests/acceptance/live/voice-smoke-cli.mjs --cleanup-evidence",
    "test:runtime": "pnpm --filter @jarvis/hermes-runtime test",
    "test:all": "pnpm test && pnpm test:runtime && pnpm test:watchdog",
    "test:watchdog": "pnpm --filter @jarvis/watchdog test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260830.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
